# Optional actual LLM inference for advisory classification. No real data/credentials.
# OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
# Override persistent trace database path if necessary.
# TB_DB_PATH=/tmp/trustboundary.sqlite3

# Set 0 to disable the local TF-IDF classifier and use heuristic patterns only.
TB_ENABLE_LOCAL_ML=1

# Visitors use the Settings tab to supply their OWN key transiently.
# Server environment key works for direct Python CLI only, NOT visitor scans.
# Never commit your API key; change exposed keys immediately.
